# AgentVerse AI - production. Copy to .env on the server, next to docker-compose.prod.yml.
# Read by both docker compose and the backend container.

# ---------- Images ----------
# Replace <owner> with your GitHub username or organisation, lowercase.
BACKEND_IMAGE=ghcr.io/<owner>/agentverse-backend:latest
FRONTEND_IMAGE=ghcr.io/<owner>/agentverse-frontend:latest

# ---------- Published ports ----------
# Other applications already use this server, so pick ports nothing else holds.
FRONTEND_PORT=8090
BACKEND_PORT=8091

# ---------- Database ----------
# In production the host is the compose service name, not localhost.
POSTGRES_USER=agentverse
POSTGRES_PASSWORD=
POSTGRES_DB=agentverse
DATABASE_URL=postgres://agentverse:<same password>@postgres:5432/agentverse

# ---------- Application ----------
# CLIENT_URL is the exact origin the browser shows. It is the CORS allow list,
# so a mismatch here blocks every API call.
NODE_ENV=production
PORT=5000
CLIENT_URL=https://agentverse.example.com
APP_NAME=AgentVerse AI
LOG_LEVEL=info

# ---------- Secrets ----------
# Generate each with: openssl rand -hex 32. The two token secrets must differ.
# COOKIE_SECURE goes true once the domain serves HTTPS, or the refresh cookie is dropped.
# ENCRYPTION_KEY encrypts the provider API keys stored in the database. Changing it
# makes them unreadable, and every key has to be pasted in again.
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECURE=false
ENCRYPTION_KEY=

# ---------- First administrator ----------
# Created on boot when no account with this email exists. Leave ADMIN_EMAIL empty
# to skip it. Changing the password here does not change an existing account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ---------- Google sign in ----------
# Optional. All three together, or none of them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.agentverse.example.com/api/auth/google/callback

# ---------- Email (SMTP) ----------
# Optional. Without SMTP_HOST the forgot password route answers 503.
# MAIL_FROM is required as soon as SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=AgentVerse AI <no-reply@agentverse.example.com>
PASSWORD_RESET_EXPIRES_IN=15m

# ============================================================
# AI providers
# Everything below is the FIRST RUN SEED ONLY. On the first boot these are copied
# into the database, encrypted, and from then on Admin > AI models owns them:
# editing them here changes nothing. Leave one empty and that provider simply
# starts unconfigured, and the app says so on the chat page.
# ============================================================

# ---------- AI: chat and voice models ----------
# LLM_PROVIDER picks which of the four below answers chat on the first boot.
LLM_PROVIDER=minimax

# ---------- AI: MiniMax ----------
# Also the account behind MiniMax text to speech further down.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3

# ---------- AI: OpenRouter ----------
# The model must support tool calling. Free models can be flaky under load.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# ---------- AI: OpenAI ----------
# One key for two jobs: an OpenAI chat model, and the Intelligence Hub embeddings.
OPENAI_API_KEY=

# ---------- AI: GLM (Z.ai) ----------
GLM_API_KEY=

# ---------- AI: speech to text ----------
# Groq or OpenAI. Without a key the microphone answers 503 and the rest still runs.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3

# ---------- AI: text to speech ----------
# MiniMax (on MINIMAX_API_KEY) or ElevenLabs. TTS_VOICE is a MiniMax voice name
# or an ElevenLabs voice id, matching whichever provider is selected.
ELEVENLABS_API_KEY=
TTS_MODEL=speech-2.8-turbo
TTS_VOICE=English_ConfidentWoman

# ---------- AI: embeddings ----------
# Runs on OPENAI_API_KEY above. Changing the model means re-indexing every hub document.
EMBEDDING_MODEL=text-embedding-3-small

# ---------- Integrations (Composio) ----------
COMPOSIO_API_KEY=
COMPOSIO_CALLBACK_URL=https://agentverse.example.com/integrations/callback

# ---------- File storage (MinIO, S3 compatible) ----------
# Without it, Intelligence Hub file uploads answer 503. Links still work.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=agentverse-intelligence-hub
